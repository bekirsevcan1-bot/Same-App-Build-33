{
  "expo": {
    "name": "Usta Cepte",
    "slug": "usta-cepte",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "usta-cepte",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usta Cepte, yakındaki ustaları göstermek ve talebinizin konumunu ilgili ustayla paylaşmak için konumunuzu kullanır.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Usta Cepte, aktif iş sırasında yalnızca ilgili iş katılımcıları arasında canlı konum güncellemesi sağlamak için konumunuzu kullanır."
      }
    },
    "android": {
      "package": "com.ustacepte.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ustaya fotoğraf göndermek için galeri erişimi gerekiyor.",
          "cameraPermission": "Ustaya fotoğraf çekmek için kamera erişimi gerekiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00C8B3",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
